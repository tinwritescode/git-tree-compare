{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "git-tree-compare",
  "identifier": "com.tinwritescode.git-tree-compare",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../frontend"
    },
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../frontend"
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "git-tree-compare",
        "width": 1024,
        "height": 768,
        "maximized": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": [
          27,
          38,
          54,
          255
        ]
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.icns"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "git-tree-compare"
        ]
      }
    }
  }
}
